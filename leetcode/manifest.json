{
  "manifest_version": 3,
  "name": "LeetCode-14ALL",
  "version": "1.0.0",
  "description": "pbhutka",
  "icons": {
    "16": "icons/image16.png",
    "32": "icons/image32.png",
    "48": "icons/image48.png",
    "128": "icons/image128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "icons/image16.png",
      "32": "icons/image32.png",
      "48": "icons/image48.png",
      "128": "icons/image128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "css": [
        "css/layout.css",
        "css/monaco.css",
        "css/company-tags.css"
      ],
      "js": [
        "scripts/content-layout.js",
        "scripts/content-monaco.js",
        "scripts/content-companies.js",
        "scripts/content-snippets.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "json/snippets.json",
        "src/initialize.js",
        "src/enable.js",
        "src/suggest.js",
        "src/disable.js"
      ],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
