{
  "manifest_version": 3,
  "name": "Codeforces Dark",
  "version": "6.7",
  "description": "pbhutka",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Codeforces Dark Theme"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://codeforces.com/*", "*://*.codeforces.com/*"],
      "js": ["/scripts/utils.js", "/scripts/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["/css/style.css", "/icons/*"],
      "matches": ["*://codeforces.com/*", "*://*.codeforces.com/*"]
    }
  ]
}
