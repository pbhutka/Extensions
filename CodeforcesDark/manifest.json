{
  "manifest_version": 3,
  "name": "Codeforces Dark",
  "version": "1.0.3",
  "description": "pbhutka",
  "icons": {
    "16": "icons/image16.png",
    "32": "icons/image32.png",
    "48": "icons/image48.png",
    "128": "icons/image128.png"
  },
  "action": {
    "default_title": "Codeforces Dark Theme"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://codeforces.com/*", "*://*.codeforces.com/*"],
      "js": ["/content/utils.js", "/content/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["/css/style.css", "/images/*"],
      "matches": ["*://codeforces.com/*", "*://*.codeforces.com/*"]
    }
  ]
}
