{
  "manifest_version": 3,
  "name": "ikhedut Gujarati",
  "version": "1.0",
  "description": "pbhutka",

  "icons": {
    "16": "icons/image16.png",
    "32": "icons/image32.png",
    "48": "icons/image48.png",
    "128": "icons/image128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/image16.png",
      "32": "icons/image32.png",
      "48": "icons/image48.png",
      "128": "icons/image128.png"
    },
    "default_title": "iKhedut Noto Sans Gujarati"
  },

  "content_scripts": [
    {
      "matches": ["https://ikhedut.gujarat.gov.in/*"],
      "css": ["/css/content.css"],
      "run_at": "document_start"
    }
  ]
}
