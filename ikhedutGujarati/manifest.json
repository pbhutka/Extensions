{
  "manifest_version": 3,
  "name": "ikhedut Gujarati",
  "version": "6.7",
  "description": "pbhutka",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "iKhedut Noto Sans Gujarati"
  },

  "content_scripts": [
    {
      "matches": ["https://ikhedut.gujarat.gov.in/*"],
      "css": ["/css/style.css"],
      "run_at": "document_start"
    }
  ]
}
