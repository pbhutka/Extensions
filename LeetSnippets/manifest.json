{
  "manifest_version": 3,
  "name": "Leetcode Snippets",
  "version": "6.7",
  "description": "pbhutka",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://leetcode.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "/scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [  
        "https://leetcode.com/problems/*",
        "https://leetcode.com/contest/*"
      ],
      "js": ["/scripts/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "/html/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "/json/snippets.json",
        "/src/initialize.js",
        "/src/enable.js",
        "/src/suggest.js",
        "/src/disable.js"
      ],
      "matches": ["https://leetcode.com/*"]
    }
  ]
}
