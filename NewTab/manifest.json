{
  "manifest_version": 3,
  "name": "New Tab",
  "version": "6.7",
  "description": "pbhutka",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "chrome_url_overrides": {
    "newtab": "/html/layout.html"
  },

  "permissions": ["storage", "favicon"],

  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
