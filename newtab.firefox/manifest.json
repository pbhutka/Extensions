{
  "manifest_version": 3,
  "name": "New Tab Dashboard",
  "version": "1.0.0",
  "description": "A custom new tab dashboard with spaces and link boards.",

  "icons": {
    "16": "icons/image16.png",
    "32": "icons/image32.png",
    "48": "icons/image48.png",
    "128": "icons/image128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "newtab-dashboard@example.com",
      "strict_min_version": "109.0"
    }
  },

  "permissions": ["storage"],

  "chrome_url_overrides": {
    "newtab": "html/layout.html"
  }
}
